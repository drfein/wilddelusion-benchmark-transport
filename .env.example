# Required only for OpenAI generation, validation, and judge stages.
OPENAI_API_KEY=

# Required for gated Hugging Face checkpoints such as Llama.
HF_TOKEN=

# Exact natural-control reproduction includes licensed source rows that cannot
# be redistributed here. Point this at the output directory produced by
# scripts/build_natural_near_miss_controls.py.
WD_NATURAL_CONTROL_DIR=

# Optional shared caches.
HF_HOME=.cache/huggingface
WD_MODEL_DIR=.cache/models
